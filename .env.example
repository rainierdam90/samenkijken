# ---- Admin dashboard ----
# Strong password to view live counts + monitor chat at /admin
ADMIN_PASSWORD=change-me-to-something-long

# ---- Your own TURN (coturn) ----
# Shared secret, must match coturn's "static-auth-secret"
TURN_SECRET=
# Comma-separated TURN URLs (point at YOUR coturn host)
# e.g. turn:turn.watchmovietogether.com:3478,turns:turn.watchmovietogether.com:5349
TURN_URLS=
# Credential lifetime in seconds (default 3600 = 1h, used only with TURN_SECRET)
TURN_TTL=3600

# --- OR: managed TURN with STATIC credentials (Metered/Twilio/etc.) ---
# Use these INSTEAD of TURN_SECRET. Set TURN_URLS to the provider's turn: URLs.
TURN_USERNAME=
TURN_CREDENTIAL=

# ---- SECOND TURN provider (reserve, RECOMMENDED) ----
# A single TURN server cannot relay between two of its OWN relay addresses, so when TWO people
# are both behind a VPN / symmetric NAT at the same time, their call fails. A reserve relay on a
# DIFFERENT host/IP fixes that. Use any provider with a different IP than your primary coturn
# (e.g. Metered free tier, Cloudflare TURN, or a second coturn box). Leave blank to disable.
# Static-credential provider (easiest — e.g. Metered dashboard):
TURN2_URLS=
TURN2_USERNAME=
TURN2_CREDENTIAL=
# OR a second coturn with use-auth-secret (HMAC):
TURN2_SECRET=
TURN2_TTL=3600

# ---- Room limits ----
MAX_ROOM=8
CHAT_KEEP=300

# PORT is provided by the host (Render/Railway/Fly). Locally defaults to 8080.

# ---- YouTube search (optional) ----
# YouTube Data API v3 key. Stays server-side (browser never sees it).
YT_API_KEY=

# ---- Remote MKV / opaque direct-video streaming ----
# Optional system binary; when blank the bundled ffmpeg-static dependency is used.
FFMPEG_PATH=
# Set a stable value when running more than one Node instance.
MKV_TOKEN_SECRET=
MKV_TOKEN_TTL=300
MKV_MAX_STREAMS=4
MKV_MAX_STREAMS_PER_IP=2
# HEVC/H.265 IPTV fallback: one shared, single-threaded H.264 job by default.
MKV_MAX_TRANSCODES=1
MKV_MAX_TRANSCODES_PER_IP=1
MKV_TRANSCODE_THREADS=1
MKV_SHARED_BACKLOG=8388608
# 0 = copy video and convert audio to broadly compatible AAC (recommended).
# 1 = copy both video and audio; lowest CPU, but unsupported MKV audio may be silent/fail.
MKV_COPY_AUDIO=0
# Blank deliberately permits every PUBLIC host. Set only if you want to restrict sources.
MKV_ALLOWED_HOSTS=
# Exact private-resolving source hosts you own; this does not restrict other public hosts.
MKV_TRUSTED_PRIVATE_HOSTS=turn.watchmovietogether.com
MKV_ALLOWED_PORTS=80,443,8080,8443
# Keep 0 in production. Private sources require both 1 and an explicit MKV_ALLOWED_HOSTS entry.
MKV_ALLOW_PRIVATE=0

# ---- IPTV gateway (Xtream-compatible login and M3U playlists) ----
# Provider logins live only in short-lived process memory. Streams pass through this server.
# Idle TTLs slide while the source is in use; the MAX ones are absolute ceilings so a leaked
# token cannot be kept alive by polling. A provider login is also dropped when its room empties.
IPTV_SOURCE_TTL=7200
IPTV_SOURCE_MAX_TTL=43200
IPTV_STREAM_TTL=1800
IPTV_STREAM_MAX_TTL=28800
# Defaults are sized for a 512MB instance; raise them on a bigger plan.
IPTV_MAX_SESSIONS=25
IPTV_MAX_TICKETS=2000
IPTV_MAX_CATALOG_BYTES=16777216
IPTV_MAX_PLAYLIST_BYTES=12582912
# A household shares one public IP and each HLS player keeps several fetches open, so the
# per-IP ceiling has to fit a living room rather than a single viewer.
IPTV_MAX_STREAMS=48
IPTV_MAX_STREAMS_PER_IP=16
# Catalogue thumbnails get their own budget — sharing the stream slots let browsing starve playback.
IPTV_MAX_ART=24
IPTV_MAX_ART_PER_IP=12
# Blank deliberately permits every PUBLIC host. Use an allowlist to restrict providers.
IPTV_ALLOWED_HOSTS=
# Only list an exact internal provider host that you operate and intend to expose.
IPTV_TRUSTED_PRIVATE_HOSTS=
IPTV_ALLOWED_PORTS=80,443,8000,8080,8443,8880,25461
# Some Xtream panels serve media only to a recognised player identity.
IPTV_MEDIA_USER_AGENT=VLC/3.0.21 LibVLC/3.0.21
# Set to the public backend origin when proxy URLs are generated behind an unusual reverse proxy.
IPTV_PUBLIC_BASE=
